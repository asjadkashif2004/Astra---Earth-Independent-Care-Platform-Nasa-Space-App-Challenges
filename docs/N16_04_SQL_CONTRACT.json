  "sqlite_schema": "CREATE TABLE fixture_meta(key TEXT PRIMARY KEY,json TEXT NOT NULL);\nCREATE TABLE observations(crew_id TEXT NOT NULL,metric TEXT NOT NULL,json TEXT NOT NULL,sha256 TEXT NOT NULL,PRIMARY KEY(crew_id,metric));\nCREATE TABLE baselines(crew_id TEXT NOT NULL,metric TEXT NOT NULL,json TEXT NOT NULL,sha256 TEXT NOT NULL,PRIMARY KEY(crew_id,metric));\nCREATE TABLE risks(id TEXT PRIMARY KEY,crew_id TEXT NOT NULL,status TEXT NOT NULL,json TEXT NOT NULL,sha256 TEXT NOT NULL);\nCREATE INDEX risk_scope ON risks(crew_id,status,id);",
  "queries": {
    "metadata": "SELECT key,json FROM fixture_meta WHERE key IN (?,?,?) ORDER BY key",
    "observation": "SELECT crew_id,metric,json,sha256 FROM observations WHERE crew_id=? AND metric=?",
    "baseline": "SELECT crew_id,metric,json,sha256 FROM baselines WHERE crew_id=? AND metric=?",
    "risks": "SELECT id,crew_id,status,json,sha256 FROM risks WHERE crew_id=? AND status=? ORDER BY id LIMIT ?"
  },
