3d4c74b8f902ca1de87a3da02f40c5e","chunk_sha256":"0e41139dc6ba5c69d9ec683793fc681f5d0fafed0e9387bbcb7d07c07481b9db","document_id":"nasa-hrp-sleep-2016","end":3183,"original_sha256":"252d4993a040ab8b989664b1da7a3143a5fd8169fac65b67f1f43231250ef1f5","page_index":13,"page_sha256":"0fe103834cb4b85604a9ab574c9b3b4da8479dde4f071b1a9e8e82f3cd46ec8b","section_id":"section-3504f1b89bf2c9387d58bb61cc1572614f2cde24c3f3329ffad1d18772a7a33a","source_url":"https://ntrs.nasa.gov/api/citations/20160003864/downloads/20160003864.pdf","start":1820}],"base_section_labels_authoritative":false,"document_id":"nasa-hrp-sleep-2016","end":2419,"offset_unit":"UTF-16 code units","original_sha256":"252d4993a040ab8b989664b1da7a3143a5fd8169fac65b67f1f43231250ef1f5","page_index":13,"page_sha256":"0fe103834cb4b85604a9ab574c9b3b4da8479dde4f071b1a9e8e82f3cd46ec8b","start":1887,"text":"Circadian desynchronization can arise from two situations. First, the imposed \nsleep-work schedule can lead to a scheduled wakefulness occurring during the circadian \nnadir and scheduled sleep occurring during the wake-promoting portion of the circadian \nrhythm. Second, under a stable sleep-wake schedule, the endogenous circadian rhythm \ncan drift to an earlier or later phase due to insufficient or inappropriately timed light \nexposure. Both of these causes of circadian desynchronization have been observed during \nspaceflight.","text_sha256":"f71b629f3455e889cc330e5b0676c4087ef88bbdc5d12e9c36024b91db0052b5"},"claim_readiness":"bounded_source_text","id":"window-bd72d3e365f75f34d10069ec30c7d81b499c1d5733279646c0358136b6effe2e","key":"flight-circadian-mechanisms","limits":"Mechanistic context does not identify a current astronaut's internal phase from HR or SpO2.","review":"pending_independent_review","role":"background","section_id":"curated-section-c95e0663bf78793617e6d1e5c47bd8b614250e929f1c9787542dcd7b2dbcd939","source":{"attribution":"Flynn-Evans E, Gregory K, Arsintescu L, Whitmire A. NASA HRP sleep/circadian/wo