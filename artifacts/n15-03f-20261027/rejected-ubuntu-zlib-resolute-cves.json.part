ly1.3.1-1ubuntu3.1","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.1-1ubuntu3.1","pocket":"security"},{"name":"libminizip1t64","version":"1:1.3.dfsg+really1.3.1-1ubuntu3.1","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.1-1ubuntu3.1","pocket":"security"},{"name":"libx32z1","version":"1:1.3.dfsg+really1.3.1-1ubuntu3.1","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.1-1ubuntu3.1","pocket":"security"},{"name":"libx32z1-dev","version":"1:1.3.dfsg+really1.3.1-1ubuntu3.1","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.1-1ubuntu3.1","pocket":"security"},{"name":"minizip","version":"1:1.3.dfsg+really1.3.1-1ubuntu3.1","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.1-1ubuntu3.1","pocket":"security"},{"name":"zlib1g","version":"1:1.3.dfsg+really1.3.1-1ubuntu3.1","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.1-1ubuntu3.1","pocket":"security"},{"name":"zlib1g-dev","version":"1:1.3.dfsg+really1.3.1-1ubuntu3.1","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.1-1ubuntu3.1","pocket":"security"}]},"type":"USN","cves_ids":["CVE-2026-27171"]}]},{"id":"CVE-2026-22184","published":"2026-01-07T21:16:00","updated_at":"2026-10-23T03:26:23.731661+00:00","description":"\nzlib versions up to and including 1.3.1.2 include a global buffer overflow\nin the untgz utility located under contrib/untgz. The vulnerability is\nlimited to the standalone demonstration utility and does not affect the\ncore zlib compression library. The flaw occurs when a user executes the\nuntgz command with an excessively long archive name supplied via the\ncommand line, leading to an out-of-bounds write in a fixed-size global\nbuffer.","ubuntu_description":"","notes":[{"author":"mdeslaur","note":"since 3.2.0-1, rsync builds with the system zlib"},{"author":"0xnishit","note":"untgz not presnet since 1:1.2.3.5.dfsg-1 version in zlib"},{"author":"Bruce","note":"Disputed by upstream as affected file \"untag.c\" under the contrib\ndirectory is not part of zlibc.\n(See https://github.com/madler/zlib/issues/754)"}],"codename":null,"priority":"medium","cvss3":9.8,"impact":{"baseMetricV3":{"cvssV3":{"version":"3.1","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","attackVector":"NETWORK","attackComplexity":"LOW","privilegesRequired":"NONE","userInteraction":"NONE","scope":"UNCHANGED","confidentialityImpact":"HIGH","integrityImpact":"HIGH","availabilityImpact":"HIGH","baseScore":9.8,"baseSeverity":"CRITICAL"}},"baseMetricV4":{"cvssV4":{"version":"4.0","vectorString":"CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:A/VC:L/VI:N/VA:L/SC:N/SI:N/SA:N","baseMetrics":{"exploitabilityMetrics":{"attackVector":"LOCAL","attackComplexity":"LOW","attackRequirements":"NONE","privilegesRequired":"NONE","userInteraction":"ACTIVE"},"vulnerableSystemImpactMetrics":{"confidentialityImpact":"LOW","integrityImpact":"NONE","availabilityImpact":"LOW"},"subsequentSystemImpactMetrics":{"confidentialityImpact":"NONE","integrityImpact":"NONE","availabilityImpact":"NONE"}},"baseScore":4.6,"baseSeverity":"MEDIUM"}}},"status":"active","mitigation":"","references":["https://www.cve.org/CVERecord?id=CVE-2026-22184","https://github.com/madler/zlib","https://seclists.org/fulldisclosure/2026/Jan/3","https://www.vulncheck.com/advisories/zlib-untgz-global-buffer-overflow-in-tgzfname","https://zlib.net/"],"bugs":["https://github.com/madler/zlib/issues/1142"],"patches":{"zlib":[],"rsync":[],"klibc":[],"zsync":[]},"tags":{},"packages":[{"name":"zlib","source":"https://ubuntu.com/security/cve?package=zlib","ubuntu":"https://packages.ubuntu.com/search?suite=all&section=all&arch=any&searchon=sourcenames&keywords=zlib","debian":"https://tracker.debian.org/pkg/zlib","statuses":[{"release_codename":"resolute","status":"not-affected","description":"untgz not present","component":null,"pocket":"security"},{"release_codename":"upstream","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"bionic","status":"not-affected","description":"untgz not present","component":null,"pocket":"security"},{"release_codename":"focal","status":"not-affected","description":"untgz not present","component":null,"pocket":"security"},{"release_codename":"jammy","status":"not-affected","description":"untgz not present","component":null,"pocket":"security"},{"release_codename":"noble","status":"not-affected","description":"untgz not present","component":null,"pocket":"security"},{"release_codename":"plucky","status":"not-affected","description":"untgz not present","component":null,"pocket":"security"},{"release_codename":"questing","status":"not-affected","description":"untgz not present","component":null,"pocket":"security"},{"release_codename":"trusty","status":"not-affected","description":"untgz not present","component":null,"pocket":"security"},{"release_codename":"xenial","status":"not-affected","description":"untgz not present","component":null,"pocket":"security"},{"release_codename":"stonking","status":"not-affected","description":"untgz not present","component":null,"pocket":"security"}]},{"name":"rsync","source":"https://ubuntu.com/security/cve?package=rsync","ubuntu":"https://packages.ubuntu.com/search?su