},{"name":"libminizip1t64","version":"1:1.3.dfsg+really1.3.2-3ubuntu1.1","is_source":false,"is_visible":false,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.2-3ubuntu1.1","pocket":"security"},{"name":"libx32z1","version":"1:1.3.dfsg+really1.3.2-3ubuntu1.1","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.2-3ubuntu1.1","pocket":"security"},{"name":"libx32z1-dev","version":"1:1.3.dfsg+really1.3.2-3ubuntu1.1","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.2-3ubuntu1.1","pocket":"security"},{"name":"minizip","version":"1:1.3.dfsg+really1.3.2-3ubuntu1.1","is_source":false,"is_visible":false,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.2-3ubuntu1.1","pocket":"security"},{"name":"zlib1g","version":"1:1.3.dfsg+really1.3.2-3ubuntu1.1","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.2-3ubuntu1.1","pocket":"security"},{"name":"zlib1g-dev","version":"1:1.3.dfsg+really1.3.2-3ubuntu1.1","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg+really1.3.2-3ubuntu1.1","pocket":"security"}]},"type":"USN","cves_ids":["CVE-2026-85091"]}]},{"id":"CVE-2026-3381","published":"2026-03-05T00:00:00","updated_at":"2026-03-07T01:53:37.510307+00:00","description":"\nCompress::Raw::Zlib versions through 2.219 for Perl use potentially\ninsecure versions of zlib.\nCompress::Raw::Zlib includes a copy of the zlib library.\nCompress::Raw::Zlib version 2.220 includes zlib 1.3.2, which addresses\nfindings fron the 7ASecurity audit of zlib. The includes fixs for\nCVE-2026-27171.","ubuntu_description":"","notes":[],"codename":null,"priority":"medium","cvss3":9.8,"impact":{"baseMetricV3":{"cvssV3":{"version":"3.1","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","attackVector":"NETWORK","attackComplexity":"LOW","privilegesRequired":"NONE","userInteraction":"NONE","scope":"UNCHANGED","confidentialityImpact":"HIGH","integrityImpact":"HIGH","availabilityImpact":"HIGH","baseScore":9.8,"baseSeverity":"CRITICAL"}}},"status":"active","mitigation":"","references":["https://www.cve.org/CVERecord?id=CVE-2026-3381","https://lists.security.metacpan.org/cve-announce/msg/37638919/","https://7asecurity.com/blog/2026/02/zlib-7asecurity-audit/","https://github.com/madler/zlib","https://github.com/madler/zlib/releases/tag/v1.3.2","https://metacpan.org/release/PMQS/Compress-Raw-Zlib-2.221/source/Changes","https://www.cve.org/CVERecord?id=CVE-2026-27171","https://www.zlib.net/"],"bugs":[""],"patches":{"libcompress-raw-zlib-perl":[],"perl":[]},"tags":{},"packages":[{"name":"libcompress-raw-zlib-perl","source":"https://ubuntu.com/security/cve?package=libcompress-raw-zlib-perl","ubuntu":"https://packages.ubuntu.com/search?suite=all&section=all&arch=any&searchon=sourcenames&keywords=libcompress-raw-zlib-perl","debian":"https://tracker.debian.org/pkg/libcompress-raw-zlib-perl","statuses":[{"release_codename":"xenial","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"stonking","status":"not-affected","description":"","component":null,"pocket":"security"},{"release_codename":"resolute","status":"not-affected","description":"","component":null,"pocket":"security"},{"release_codename":"bionic","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"focal","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"jammy","status":"not-affected","description":"2.101-1build1","component":null,"pocket":"security"},{"release_codename":"noble","status":"not-affected","description":"","component":null,"pocket":"security"},{"release_codename":"questing","status":"not-affected","description":"","component":null,"pocket":"security"},{"release_codename":"upstream","status":"released","description":"2.011-2","component":null,"pocket":"security"}]},{"name":"perl","source":"https://ubuntu.com/security/cve?package=perl","ubuntu":"https://packages.ubuntu.com/search?suite=all&section=all&arch=any&searchon=sourcenames&keywords=perl","debian":"https://tracker.debian.org/pkg/perl","statuses":[{"release_codename":"bionic","status":"not-affected","description":"Bundled zlib not compiled","component":null,"pocket":"security"},{"release_codename":"focal","status":"not-affected","description":"Bundled zlib not compiled","component":null,"pocket":"security"},{"release_codename":"trusty","status":"not-affected","description":"Bundled zlib not compiled","component":null,"pocket":"security"},{"release_codename":"xenial","status":"not-affected","description":"Bundled zlib not compiled","component":null,"pocket":"security"},{"release_codename":"stonking","status":"not-affected","description":"","component":null,"pocket":"security"},{"release_codename":"resolute","status":"not-affected","description":"","component":null,"pocket":"security"},{"release_codename":"jammy","status":"not-affected","description":"5.34.0-3ubuntu1.5","component":null,"pocket":"security"},{"release_codename":"noble","status":"not-affected","description":"","component":null,"pocket":"security"},{"release_codename":"questing","status":"not-affected","description":"","component":null,"pocket":"security"},{"release_codename":"upstream","status":"released","description":"5.10.0-21","component":null,"pocket":"security"}]}],"notices_ids":[],"notices":[]},{"id":"CVE-2026-27171","published":"2026-02-18T04:16:00","updated_at":"2026-09-01T14:07:25.646213+00:00","description":"\nzlib before 1.3.2 allows CPU consumption via crc32_combine64 and\ncrc32_combine_gen64 because x2nmodp can do right shifts within a loop that\nhas no termination condition.","ubuntu_description":"","notes":[{"author":"","note":"Priority reason:\nResource consumption via API misuse only"},{"author":"mdeslaur","note":"since 3.2.0-1, rsync builds with the system zlib\nThis issue stems from the misuse of an API, no indication that\nthe API is being misused by anything in Ubuntu. This would only\nresult in cpu consumption if it is in fact being misused.\nMarking this issue as low priority."},{"author":"pfsmorigo","note":"The vulnerable code was introduced in zlib 1.3.0.\nrsync from trusty to focal bundle zlib 1.2.8.\nklibc from trusty to resolute bundle zlib 1.2.3.\nzsync from trusty to resolute bundle zlib 1.2.1.1."}],"codename":null,"priority":"low","cvss3":2.9,"impact":{"baseMetricV3":{"cvssV3":{"version":"3.1","vectorString":"CVSS:3.1/AV:L/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:L","attackVector":"LOCAL","attackComplexity":"HIGH","privilegesRequired":"NONE","userInteraction":"NONE","scope":"UNCHANGED","confidentialityImpact":"NONE","integrityImpact":"NONE","availabilityImpact":"LOW","baseScore":2.9,"baseSeverity":"LOW"}}},"status":"active","mitigation":"","references":["https://ubuntu.com/security/notices/USN-8706-1","https://www.cve.org/CVERecord?id=CVE-2026-27171","https://7asecurity.com/blog/2026/02/zlib-7asecurity-audit/","https://7asecurity.com/reports/pentest-report-zlib-RC1.1.pdf","https://github.com/madler/zlib/releases/tag/v1.3.2","https://ostif.org/zlib-audit-complete/"],"bugs":["http://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1128336","https://github.com/madler/zlib/issues/904"],"patches":{"zlib":[],"rsync":[],"klibc":[],"zsync":[]},"tags":{},"packages":[{"name":"zlib","source":"https://ubuntu.com/security/cve?package=zlib","ubuntu":"https://packages.ubuntu.com/search?suite=all&section=all&arch=any&searchon=sourcena