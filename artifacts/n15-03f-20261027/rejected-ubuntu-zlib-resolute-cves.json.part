{"cves":[{"id":"CVE-2026-85091","published":"2026-09-03T13:06:00","updated_at":"2026-10-22T21:01:03.591444+00:00","description":"\nzlib versions 1.3.1.2 through 1.3.2 contain a heap buffer overflow\nvulnerability in the gz_vacate() function when processing non-blocking\ngzwrite() operations with stale external buffer pointers. Attackers can\ntrigger the overflow by calling gzprintf() or gzvprintf() after a write\nstall, causing an unchecked memmove() to write beyond the internal input\nbuffer boundary.","ubuntu_description":"","notes":[{"author":"mdeslaur","note":"since 3.2.0-1, rsync builds with the system zlib\n\nIt is unclear by this CVE, and the advisory that goes along with\nit, what versions of zlib are affected by this issue.\n\nPer the advisory, versions below 1.3.1 are not affected, but the\nreproducer crashes 1.3.0 in the same way it does 1.3.1.\n\nThe more severe vulnerability was introduced in 1.3.1.2 by the\nfollowing commit:\nhttps://github.com/madler/zlib/commit/81cc0be\n\nSee request for more information here:\nhttps://github.com/madler/zlib/issues/1310#issuecomment-5979623265\n\nNeed to test the new patch below to make sure it actually fixes\nthe issue."},{"author":"mrmajumder","note":"The current upstream patch has been applied to versions 1.3.1\nand above for zlib. However, based on pending upstream decision,\nthe lower versions may also be affected (2026-10-22)"}],"codename":null,"priority":"medium","cvss3":7.4,"impact":{"baseMetricV3":{"cvssV3":{"version":"3.1","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:H/A:H","attackVector":"NETWORK","attackComplexity":"HIGH","privilegesRequired":"NONE","userInteraction":"NONE","scope":"UNCHANGED","confidentialityImpact":"NONE","integrityImpact":"HIGH","availabilityImpact":"HIGH","baseScore":7.4,"baseSeverity":"HIGH"}},"baseMetricV4":{"cvssV4":{"version":"4.0","vectorString":"CVSS:4.0/AV:N/AC:H/AT:N/PR:N/UI:N/VC:N/VI:H/VA:H/SC:N/SI:N/SA:N","baseMetrics":{"exploitabilityMetrics":{"attackVector":"NETWORK","attackComplexity":"HIGH","attackRequirements":"NONE","privilegesRequired":"NONE","userInteraction":"NONE"},"vulnerableSystemImpactMetrics":{"confidentialityImpact":"NONE","integrityImpact":"HIGH","availabilityImpact":"HIGH"},"subsequentSystemImpactMetrics":{"confidentialityImpact":"NONE","integrityImpact":"NONE","availabilityImpact":"NONE"}},"baseScore":8.3,"baseSeverity":"HIGH"}}},"status":"active","mitigation":"","references":["https://www.cve.org/CVERecord?id=CVE-2026-85091","https://gist.github.com/thesmartshadow/e0b9481792afb7c31e86fee1ff084490","https://www.vulncheck.com/advisories/zlib-1.3.1.2-through-1.3.2-heap-buffer-overflow-via-gz-vacate","https://ubuntu.com/security/notices/USN-8954-1"],"bugs":["https://github.com/madler/zlib/issues/1310"],"patches":{"zlib":["upstream: https://github.com/madler/zlib/commit/df84af25dc1942490e1d1c899a07619152a46148"],"rsync":[],"klibc":[],"zsync":[]},"tags":{},"packages":[{"name":"zlib","source":"https://ubuntu.com/security/cve?package=zlib","ubuntu":"https://packages.ubuntu.com/search?suite=all&section=all&arch=any&searchon=sourcenames&keywords=zlib","debian":"https://tracker.debian.org/pkg/zlib","statuses":[{"release_codename":"upstream","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"noble","status":"released","description":"1:1.3.dfsg-3.1ubuntu2.3","component":null,"pocket":"security"},{"release_codename":"resolute","status":"released","description":"1:1.3.dfsg+really1.3.1-1ubuntu3.2","component":null,"pocket":"security"},{"release_codename":"bionic","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"focal","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"jammy","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"trusty","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"xenial","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"stonking","status":"released","description":"1:1.3.dfsg+really1.3.2-3ubuntu1.1","component":null,"pocket":"security"}]},{"name":"rsync","source":"https://ubuntu.com/security/cve?package=rsync","ubuntu":"https://packages.ubuntu.com/search?suite=all&section=all&arch=any&searchon=sourcenames&keywords=rsync","debian":"https://tracker.debian.org/pkg/rsync","statuses":[{"release_codename":"bionic","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"focal","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"xenial","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"trusty","status":"not-affected","description":"uses system zlib","component":null,"pocket":"security"},{"release_codename":"jammy","status":"not-affected","description":"uses system zlib","component":null,"pocket":"security"},{"release_codename":"noble","status":"not-affected","description":"uses system zlib","component":null,"pocket":"security"},{"release_codename":"resolute","status":"not-affected","description":"uses system zlib","component":null,"pocket":"security"},{"release_codename":"upstream","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"stonking","status":"not-affected","description":"uses system zlib","component":null,"pocket":"security"}]},{"name":"klibc","source":"https://ubuntu.com/security/cve?package=klibc","ubuntu":"https://packages.ubuntu.com/search?suite=all&section=all&arch=any&searchon=sourcenames&keywords=klibc","debian":"https://tracker.debian.org/pkg/klibc","statuses":[{"release_codename":"bionic","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"focal","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"jammy","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"noble","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"resolute","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"trusty","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"xenial","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"upstream","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"stonking","status":"needed","description":"","component":null,"pocket":"security"}]},{"name":"zsync","source":"https://ubuntu.com/security/cve?package=zsync","ubuntu":"https://packages.ubuntu.com/search?suite=all&section=all&arch=any&searchon=sourcenames&keywords=zsync","debian":"https://tracker.debian.org/pkg/zsync","statuses":[{"release_codename":"bionic","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"jammy","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"noble","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"resolute","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"upstream","status":"needs-triage","description":"","component":null,"pocket":"security"},{"release_codename":"focal","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"xenial","status":"needed","description":"","component":null,"pocket":"security"},{"release_codename":"stonking","status":"needed","description":"","component":null,"pocket":"security"}]}],"notices_ids":["USN-8954-1"],"notices":[{"id":"USN-8954-1","title":"zlib vulnerability","summary":"zlib could be made to crash or run programs if it received specially\ncrafted input.","instructions":"In general, a standard system update will make all the necessary changes.","references":[],"published":"2026-10-22T19:54:53.531412","description":"Ali Firas discovered that zlib incorrectly handled certain non-blocking\nwrite operations. An attacker could possibly use this issue to trigger a\nheap buffer overflow, resulting in a denial of service or arbitrary code\nexecution.","is_hidden":false,"release_packages":{"noble":[{"name":"zlib","version":"1:1.3.dfsg-3.1ubuntu2.3","description":"Lossless data-compression library","is_source":true},{"name":"lib32z1","version":"1:1.3.dfsg-3.1ubuntu2.3","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg-3.1ubuntu2.3","pocket":"security"},{"name":"lib32z1-dev","version":"1:1.3.dfsg-3.1ubuntu2.3","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg-3.1ubuntu2.3","pocket":"security"},{"name":"lib64z1","version":"1:1.3.dfsg-3.1ubuntu2.3","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg-3.1ubuntu2.3","pocket":"security"},{"name":"lib64z1-dev","version":"1:1.3.dfsg-3.1ubuntu2.3","is_source":false,"is_visible":true,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg-3.1ubuntu2.3","pocket":"security"},{"name":"libminizip-dev","version":"1:1.3.dfsg-3.1ubuntu2.3","is_source":false,"is_visible":false,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zlib/1:1.3.dfsg-3.1ubuntu2.3","pocket":"security"},{"name":"libminizip1t64","version":"1:1.3.dfsg-3.1ubuntu2.3","is_source":false,"is_visible":false,"source_link":"https://launchpad.net/ubuntu/+source/zlib","version_link":"https://launchpad.net/ubuntu/+source/zli